# Copy to .env and fill in. .env is gitignored and must never be committed.
# No secrets belong in this file or in .env -- real secrets live in Secret Manager.

# ---- Google Cloud ----
PROJECT_ID=attestor-505506
REGION=us-central1

# ---- Buckets (created by infra/bootstrap.sh) ----
UPLOADS_BUCKET=attestor-505506-uploads
CORPUS_BUCKET=attestor-505506-corpus
EXPORTS_BUCKET=attestor-505506-exports
STAGING_BUCKET=attestor-505506-staging

# ---- Models (confirmed in docs/proof/PHASE-0-DISCOVERY.md) ----
MODEL_REASONING=gemini-3.5-flash
MODEL_CLASSIFY=gemini-3.5-flash-lite

# ---- Model Armor ----
ARMOR_INGRESS_TEMPLATE=attestor-strict-ingress
ARMOR_EGRESS_TEMPLATE=attestor-egress-pii

# ---- Agent Runtime ----
# Set after the first deploy; printed by services/runtime/deploy.py
REASONING_ENGINE_ID=

# ---- Local dev ----
LOG_LEVEL=INFO
